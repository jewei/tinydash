{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TinyDash",
  "identifier": "dev.tinydash.launcher",
  "build": {
    "beforeDevCommand": "vp dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "vp build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "launcher",
        "url": "index.html",
        "title": "TinyDash",
        "width": 880,
        "height": 560,
        "center": true,
        "visible": false,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: icon: clip: http://icon.localhost http://clip.localhost; font-src 'self'; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "nsis", "deb"],
    "category": "Utility",
    "shortDescription": "A small, keyboard-first desktop launcher",
    "longDescription": "Search apps, files, clipboard history, snippets, and emoji. Calculate, convert units, currencies, and time zones, and run system commands.",
    "homepage": "https://github.com/jewei/tinydash",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": { "minimumSystemVersion": "12.0", "signingIdentity": "-" },
    "windows": { "nsis": { "installMode": "currentUser" } },
    "linux": { "deb": { "section": "utils", "depends": ["libxdo3"] } }
  }
}
