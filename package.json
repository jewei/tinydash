{
  "name": "tinydash",
  "private": true,
  "version": "0.1.3",
  "license": "MIT",
  "type": "module",
  "packageManager": "bun@1.4.2",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "tauri": "tauri",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "test:ui": "playwright test",
    "test:native": "bun tests/native/smoke.ts",
    "verify": "bun scripts/verify/run.ts quick",
    "verify:full": "bun scripts/verify/run.ts full",
    "verify:browser": "bun scripts/verify/run.ts browser",
    "verify:native": "bun scripts/verify/run.ts native",
    "check:repo": "bun scripts/verify/repository.ts"
  },
  "dependencies": {
    "@solidjs/web": "2.0.0-rc.11",
    "@tauri-apps/api": "3.0.0-alpha.2",
    "solid-js": "2.0.0-rc.11"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0-alpha-1790635538000",
    "@solidjs/vite-plugin": "3.0.0-next.46",
    "@tauri-apps/cli": "3.0.0-alpha.3",
    "@types/node": "26.6.3",
    "prettier": "4.0.0-alpha.13",
    "typescript": "7.1.0-dev.20260928.1",
    "vite": "8.3.1"
  },
  "patchedDependencies": {
    "solid-js@2.0.0-rc.11": "patches/solid-js@2.0.0-rc.11.patch"
  }
}
