{
  "name": "tinydash",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "tauri dev",
    "web": "vp dev",
    "build": "tauri build",
    "check": "vp check && cargo fmt --manifest-path src-tauri/Cargo.toml --check && cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets --locked -- -D warnings",
    "test": "vp test && cargo test --manifest-path src-tauri/Cargo.toml --locked",
    "verify": "bun run check && bun run test && bun scripts/check-generated.ts",
    "fix": "vp check --fix && cargo fmt --manifest-path src-tauri/Cargo.toml",
    "emoji-data": "bun scripts/emoji-data.ts",
    "prepare": "vp config --no-agent",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.1",
    "solid-js": "1.9.15"
  },
  "devDependencies": {
    "@solidjs/testing-library": "0.8.10",
    "@tauri-apps/cli": "2.12.1",
    "@types/bun": "1.4.2",
    "jsdom": "30.1.2",
    "typescript": "7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.0.0",
    "vite-plugin-solid": "2.11.14",
    "vite-plus": "1.0.0"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.0.0",
    "vitest": "5.0.1"
  },
  "packageManager": "bun@1.4.2"
}
