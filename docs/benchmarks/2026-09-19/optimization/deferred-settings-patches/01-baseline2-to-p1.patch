+#[derive(Clone, Debug, Eq, PartialEq, Copy)]
+#[repr(u8)]
+pub enum WindowEvent {
+  Focused(bool),
+  Created,
+  Resized,
+  RedrawNeeded,
+  Destroyed,
+}
