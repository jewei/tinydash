+// event must be copyable to be used in the event loop
+#[derive(Clone, Debug, Eq, PartialEq, Copy)]
+#[repr(u8)]
+pub enum Event {
+  Start,
+  Resume,
+  Pause,
+  Stop,
+  LowMemory,
+  WindowEvent { id: WindowId, event: WindowEvent },
+  ContentRectChanged,
+  Opened,
+}
