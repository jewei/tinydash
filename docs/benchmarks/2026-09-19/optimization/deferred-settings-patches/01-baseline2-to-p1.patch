+  pub fn create_proxy(&self) -> EventLoopProxy<T> {
+    EventLoopProxy {
+      queue: self.sender_to_clone.clone(),
+      looper: ForeignLooper::for_thread().expect("called from event loop thread"),
+    }
+  }
