+// SPDX-License-Identifier: Apache-2.0
+
+#![cfg(any(
+  target_os = "linux",
+  target_os = "dragonfly",
+  target_os = "freebsd",
+  target_os = "netbsd",
+  target_os = "openbsd"
+))]
+
+#[cfg(feature = "x11")]
+use std::{os::raw::c_int, sync::Arc};
+
+// XConnection utilities
+#[doc(hidden)]
+#[cfg(feature = "x11")]
