+// As defined in: https://www.unicode.org/Public/MAPPINGS/VENDORS/APPLE/CORPCHAR.TXT
+fn is_corporate_character(c: char) -> bool {
+  #[allow(clippy::match_like_matches_macro)]
+  match c {
+    '\u{F700}'..='\u{F747}'
+    | '\u{F802}'..='\u{F84F}'
+    | '\u{F850}'
+    | '\u{F85C}'
+    | '\u{F85D}'
+    | '\u{F85F}'
+    | '\u{F860}'..='\u{F86B}'
+    | '\u{F870}'..='\u{F8FF}' => true,
+    _ => false,
+  }
+}
