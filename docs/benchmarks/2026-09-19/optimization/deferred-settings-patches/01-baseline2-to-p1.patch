+pub unsafe fn create_input_context(view: &NSView) -> IdRef {
+  let input_context: id = msg_send![class!(NSTextInputContext), alloc];
+  let input_context: id = msg_send![input_context, initWithClient: view];
+  IdRef::new(input_context)
+}
