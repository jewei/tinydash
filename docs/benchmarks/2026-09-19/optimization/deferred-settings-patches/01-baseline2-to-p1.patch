+fn remove_event_target_window_subclass<T: 'static>(window: HWND) {
+  let removal_result = unsafe {
+    RemoveWindowSubclass(
+      window,
+      Some(thread_event_target_callback::<T>),
+      THREAD_EVENT_TARGET_SUBCLASS_ID,
+    )
+  };
+  assert!(removal_result.as_bool());
+}
