+
+use tao::{
+  dpi::LogicalSize,
+  event::{ElementState, Event, KeyEvent, WindowEvent},
+  event_loop::{ControlFlow, EventLoop},
+  keyboard::KeyCode,
+  window::WindowBuilder,
+};
+
+#[allow(clippy::single_match)]
