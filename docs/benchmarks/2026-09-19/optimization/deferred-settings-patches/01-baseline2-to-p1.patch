+    let () = msg_send![(*marked_text_ref), release];
+    *marked_text_ref = Retained::into_raw(NSMutableAttributedString::new());
+    let input_context: id = msg_send![this, inputContext];
+    let _: () = msg_send![input_context, discardMarkedText];
