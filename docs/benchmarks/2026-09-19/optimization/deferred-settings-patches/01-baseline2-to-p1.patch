+  );
+  decl.add_method(sel!(sendEvent:), send_event as extern "C" fn(_, _, _));
+  // progress bar states, follows ProgressState
+  decl.add_ivar::<Bool>(CStr::from_bytes_with_nul(b"focusable\0").unwrap());
+  WindowClass(decl.register())
