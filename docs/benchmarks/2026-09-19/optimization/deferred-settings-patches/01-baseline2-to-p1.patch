+extern "C" fn mark_is_checking_zoomed_in(this: &Object, _sel: Sel) {
+  with_state(&*this, |state| {
+    state.is_checking_zoomed_in = true;
+  });
+}
+
+extern "C" fn clear_is_checking_zoomed_in(this: &Object, _sel: Sel) {
