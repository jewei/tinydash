+// Temporary diagnostic code. Never include this module in a product build.
+use tauri::{Emitter, Manager};
+
+fn directory() -> std::path::PathBuf {
+    std::path::PathBuf::from(env!("TINYDASH_PROBE_DIR"))
+}
+
+#[tauri::command]
+pub fn snapshot(payload: serde_json::Value) {
+    let _ = std::fs::write(directory().join("snapshot.json"), payload.to_string());
+}
+
+pub fn install(app: tauri::AppHandle) {
+    std::thread::spawn(move || loop {
+        std::thread::sleep(std::time::Duration::from_millis(100));
+        let path = directory().join("command.json");
+        let Ok(bytes) = std::fs::read(&path) else { continue };
+        let Ok(value) = serde_json::from_slice::<serde_json::Value>(&bytes) else { continue };
+        let _ = std::fs::remove_file(&path);
+        let action = value["action"].as_str().unwrap_or("").to_string();
+        let id = value["id"].clone();
+        let result: Result<(), String> = (|| {
+            match action.as_str() {
+                "hide" => crate::launcher::window::hide(&app).map_err(|e| e.to_string())?,
+                "show" => {
+                    if app.get_webview_window("main").is_none() {
+                        tauri::WebviewWindowBuilder::from_config(&app, &app.config().app.windows[0])
+                            .map_err(|e| e.to_string())?.build().map_err(|e| e.to_string())?;
+                    }
+                    crate::launcher::window::show(&app).map_err(|e| e.to_string())?;
+                }
+                "blank" => app.get_webview_window("main").ok_or("No main window")?
+                    .navigate("about:blank".parse().unwrap()).map_err(|e| e.to_string())?,
+                "destroy" => app.get_webview_window("main").ok_or("No main window")?
+                    .destroy().map_err(|e| e.to_string())?,
+                "settings" => {
+                    let handle = app.clone();
+                    tauri::async_runtime::block_on(crate::launcher::preferences::open_settings(handle))?;
+                }
+                "hide-settings" => app.get_webview_window("settings").ok_or("No settings window")?
+                    .close().map_err(|e| e.to_string())?,
+                "destroy-settings" => app.get_webview_window("settings").ok_or("No settings window")?
+                    .destroy().map_err(|e| e.to_string())?,
+                "clear" => app.get_webview_window("main").ok_or("No main window")?
+                    .emit("probe-clear-results", ()).map_err(|e| e.to_string())?,
+                "snapshot" => app.get_webview_window("main").ok_or("No main window")?
+                    .eval(r#"window.__TAURI_INTERNALS__.invoke('snapshot', { payload: {
+                        nodes: document.querySelectorAll('*').length,
+                        images: [...document.images].map(i => ({width: i.naturalWidth, height: i.naturalHeight, srcBytes: i.getAttribute('src')?.length ?? 0})),
+                        scripts: [...document.scripts].map(s => s.src.split('/').at(-1)),
+                        resultRows: document.querySelectorAll('[role=option]').length,
+                        devicePixelRatio: window.devicePixelRatio,
+                        hidden: document.hidden
+                    }})"#).map_err(|e| e.to_string())?,
+                _ => return Err(format!("Unknown action: {action}")),
+            }
+            Ok(())
+        })();
+        let _ = std::fs::write(directory().join("ack.json"),
+            serde_json::json!({"id": id, "action": action, "error": result.err()}).to_string());
+    });
+}
